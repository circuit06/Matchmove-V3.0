<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <title>Audit Dashboard</title>

    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css">
    <link rel="stylesheet" href="https://cdn.datatables.net/1.13.6/css/dataTables.bootstrap5.min.css">

    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/xlsx/0.18.5/xlsx.full.min.js"></script>

    <style>
        body {
            background-color: #f4f6f8;
            font-size: 0.9rem;
        }

        .dashboard-header {
            text-align: center;
            margin-bottom: 30px;
        }

        .card {
            border-radius: 10px;
            box-shadow: 0 3px 8px rgba(0,0,0,0.08);
            margin-bottom: 25px;
        }

        table.dataTable thead th {
            background-color: #343a40;
            color: #fff;
        }

        #dropZone {
            border: 2px dashed #6c757d;
            border-radius: 10px;
            padding: 25px;
            cursor: pointer;
            transition: background 0.2s;
        }
        #dropZone.dragover { background: #e9ecef; }

        /* Summary Cards */
        .summary-card {
            border-left-width: 6px;
            border-radius: 10px;
            padding: 18px;
            background: #fff;
        }
        .summary-title {
            font-size: 0.9rem;
            font-weight: 600;
            color: #6c757d;
        }
        .summary-value {
            font-size: 1.6rem;
            font-weight: 700;
        }

        .border-delivered { border-left-color: #17a2b8; }
        .border-returned  { border-left-color: #dc3545; }
        .border-progress  { border-left-color: #ffc107; }

        /* Count labels under charts */
        .chart-count-label {
            text-align: center;
            margin-top: 10px;
            font-weight: 600;
            color: #444;
        }

        /* Smaller Pie Chart */
        #statusPieChart {
            max-width: 140px !important;
            max-height: 140px !important;
            margin: 0 auto;
        }
    </style>
</head>

<body>

<%- include('partial/navbar') %>
<%- include('partial/sidebar') %>

<div class="container mt-4">

    <div class="dashboard-header">
        <h2>Audit Trail Dashboard</h2>
        <p class="text-muted">Upload Excel files to generate a combined dataset with analytics</p>

        <button class="btn btn-primary mt-2" data-bs-toggle="modal" data-bs-target="#uploadModal">
            Upload Excel File(s)
        </button>

        <button class="btn btn-danger mt-2" onclick="localStorage.removeItem('auditDataStore'); location.reload();">
            Clear Saved Data
        </button>

        <!-- TOTAL RECORDS -->
        <div class="mt-3">
            <h5><strong>Total Records: <span id="totalRecordsHeader">0</span></strong></h5>
        </div>
    </div>

    <!-- Summary Cards -->
    <div class="row mb-4" id="summaryCards">
        <div class="col-md-4 mb-3">
            <div class="summary-card border-delivered">
                <div class="summary-title">Delivered</div>
                <div class="summary-value" id="sumDelivered">0</div>
            </div>
        </div>
        <div class="col-md-4 mb-3">
            <div class="summary-card border-returned">
                <div class="summary-title">Returned to Sender</div>
                <div class="summary-value" id="sumReturned">0</div>
            </div>
        </div>
        <div class="col-md-4 mb-3">
            <div class="summary-card border-progress">
                <div class="summary-title">In Progress</div>
                <div class="summary-value" id="sumProgress">0</div>
            </div>
        </div>
    </div>

    <!-- Bar Chart -->
    <div class="card p-3 mb-3">
        <h6 class="mb-2">Status Overview (Bar Chart)</h6>
        <canvas id="statusBarChart" height="120"></canvas>
        <div class="chart-count-label" id="barChartTotals"></div>
    </div>

    <!-- Pie Chart -->
    <div class="card p-3 mb-3">
        <h6 class="mb-3">Status Distribution (Pie Chart)</h6>
        <canvas id="statusPieChart" width="140" height="140"></canvas>
        <div class="chart-count-label" id="pieChartTotals"></div>
    </div>

    <!-- Data Table -->
    <div class="card p-2">
        <div class="table-responsive">
            <table id="auditTable" class="table table-sm table-bordered table-hover">
                <thead>
                    <tr id="tableHeadRow">
                        <th class="text-muted">Upload an Excel file to view data</th>
                    </tr>
                </thead>
                <tbody id="tableBody"></tbody>
            </table>
        </div>
    </div>

</div>


<!-- Upload Modal -->
<div class="modal fade" id="uploadModal" tabindex="-1" aria-hidden="true">
  <div class="modal-dialog modal-dialog-centered">
    <div class="modal-content">

      <div class="modal-header">
        <h5 class="modal-title">Upload Excel File(s)</h5>
        <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
      </div>

      <div class="modal-body">
        <div class="text-center mb-2">
            <small class="text-muted">Drag & drop or click to browse</small>
        </div>

        <div class="text-center" id="dropZone">
            <h6 class="mb-1">📥 Drag & Drop Excel File Here</h6>
            <p class="text-muted">or click to browse</p>
            <small class="text-muted">Supported: .xlsx, .xls</small>
            <input type="file" id="excelInput" accept=".xlsx,.xls" hidden>
        </div>
      </div>

      <div class="modal-footer">
        <button class="btn btn-secondary" data-bs-dismiss="modal">Done</button>
      </div>

    </div>
  </div>
</div>


<!-- Scripts -->
<script src="https://code.jquery.com/jquery-3.7.1.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
<script src="https://cdn.datatables.net/1.13.6/js/jquery.dataTables.min.js"></script>
<script src="https://cdn.datatables.net/1.13.6/js/dataTables.bootstrap5.min.js"></script>

<script>

let auditData = <%- JSON.stringify(data || []) %>;
let barChart = null;
let pieChart = null;

$(document).ready(function () {
    setupDragAndDrop();

    // Load saved data if available
    const saved = loadFromLocalStorage();
    if (saved && saved.length > 0) {
        auditData = saved;
    }

    if (auditData.length > 0) {
        loadDashboard(auditData, false);
    } else {
        initEmptyTable();
    }
});

/* Drag & Drop */
function setupDragAndDrop() {
    const dropZone = document.getElementById("dropZone");
    const excelInput = document.getElementById("excelInput");

    dropZone.addEventListener("dragover", e => {
        e.preventDefault();
        dropZone.classList.add("dragover");
    });

    dropZone.addEventListener("dragleave", () => dropZone.classList.remove("dragover"));

    dropZone.addEventListener("drop", e => {
        e.preventDefault();
        dropZone.classList.remove("dragover");
        const file = e.dataTransfer.files[0];
        if (file) readExcel(file);
    });

    dropZone.addEventListener("click", () => excelInput.click());
    excelInput.addEventListener("change", e => {
        if (e.target.files[0]) readExcel(e.target.files[0]);
    });
}

/* Read Excel */
function readExcel(file) {
    const reader = new FileReader();
    reader.onload = function(e) {
        const workbook = XLSX.read(new Uint8Array(e.target.result), { type: "array" });
        const sheet = workbook.Sheets[workbook.SheetNames[0]];
        const jsonData = XLSX.utils.sheet_to_json(sheet);
        loadDashboard(jsonData, true);
    };
    reader.readAsArrayBuffer(file);
}

/* Main Dashboard Render */
function loadDashboard(newData, append) {
    auditData = append ? auditData.concat(newData) : newData;

    renderTable(auditData);
    renderCharts(auditData);
    renderSummary(auditData);

    // Update top total
    document.getElementById("totalRecordsHeader").innerText = auditData.length;

    saveToLocalStorage();
}

/* Summary Cards */
function renderSummary(data) {
    let delivered = 0, returned = 0, progress = 0;

    const statusColumn = Object.keys(data[0]).find(k => k.toLowerCase().includes("status"));

    data.forEach(row => {
        const raw = String(row[statusColumn] || "").trim().toLowerCase();
        if (raw === "delivered") delivered++;
        if (raw === "returned to sender") returned++;
        if (raw === "in progress") progress++;
    });

    document.getElementById("sumDelivered").textContent = delivered;
    document.getElementById("sumReturned").textContent = returned;
    document.getElementById("sumProgress").textContent = progress;
}

/* Render Table */
function initEmptyTable() {
    $('#auditTable').DataTable({ paging: true });
}

function renderTable(data) {
    const theadRow = document.getElementById("tableHeadRow");
    const tbody = document.getElementById("tableBody");

    if ($.fn.DataTable.isDataTable('#auditTable')) {
        $('#auditTable').DataTable().clear().destroy();
    }

    theadRow.innerHTML = "";
    tbody.innerHTML = "";

    if (!data.length) {
        theadRow.innerHTML = `<th class="text-muted">No data available</th>`;
        return;
    }

    const hiddenCols = ["No.", "ADDRESS 3", "ADDRESS 4", "PRODUCT"];
    const rename = { "PRODUCT": "CARD TYPE" };

    const keys = Object.keys(data[0]).filter(k => !hiddenCols.includes(k));

    keys.forEach(k => {
        const th = document.createElement("th");
        th.textContent = rename[k] || k;
        theadRow.appendChild(th);
    });

    data.forEach(row => {
        const tr = document.createElement("tr");
        keys.forEach(k => {
            const td = document.createElement("td");
            td.textContent = row[k] ?? "";
            tr.appendChild(td);
        });
        tbody.appendChild(tr);
    });

    $('#auditTable').DataTable({
        pageLength: 10,
        ordering: true
    });
}

/* Charts */
function renderCharts(data) {
    if (barChart) barChart.destroy();
    if (pieChart) pieChart.destroy();

    const statusColumn = Object.keys(data[0]).find(k =>
        k.toLowerCase().includes("status")
    );

    let delivered = 0, returned = 0, progress = 0;

    data.forEach(row => {
        const raw = String(row[statusColumn] || "").trim().toLowerCase();
        if (raw === "delivered") delivered++;
        if (raw === "returned to sender") returned++;
        if (raw === "in progress") progress++;
    });

    const labels = ["Delivered", "Returned to Sender", "In Progress"];
    const values = [delivered, returned, progress];

    const bgColors = [
        'rgba(23,162,184,0.7)',
        'rgba(220,53,69,0.7)',
        'rgba(255,193,7,0.7)'
    ];

    const borderColors = [
        'rgba(23,162,184,1)',
        'rgba(220,53,69,1)',
        'rgba(255,193,7,1)'
    ];

    // Bar Chart
    barChart = new Chart(document.getElementById("statusBarChart"), {
        type: 'bar',
        data: {
            labels,
            datasets: [{
                label: 'Count',
                data: values,
                backgroundColor: bgColors,
                borderColor: borderColors,
                borderWidth: 1
            }]
        }
    });

    // Pie Chart (smaller)
    pieChart = new Chart(document.getElementById("statusPieChart"), {
        type: 'pie',
        data: {
            labels,
            datasets: [{
                data: values,
                backgroundColor: bgColors
            }]
        }
    });

    // Labels under charts
    document.getElementById("barChartTotals").innerText =
        `Delivered: ${delivered} | Returned: ${returned} | In Progress: ${progress}`;

    document.getElementById("pieChartTotals").innerText =
        `Delivered: ${delivered} | Returned: ${returned} | In Progress: ${progress}`;
}

/* Local Storage */
function saveToLocalStorage() {
    localStorage.setItem("auditDataStore", JSON.stringify(auditData));
}
function loadFromLocalStorage() {
    try {
        return JSON.parse(localStorage.getItem("auditDataStore"));
    } catch {
        return null;
    }
}

</script>

</body>
</html>
