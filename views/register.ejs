<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>

    <title>Register</title>

    <style>
        body {
            font-family: "Helvetica World", sans-serif;
            margin: 0;
            padding: 0;
            height: 100vh;
            display: flex;
            flex-direction: column;
            justify-content: center;
            align-items: center;
            background-color: #f9f9f9;
        }

        .navbar {
            text-align: center;
            margin-bottom: 15px;
        }

        .navbar .title img.logo {
            max-height: 100px;
            width: auto;
        }

        .signup-section {
            max-width: 550px;
            width: 100%;
            text-align: center;
        }

        .form-control {
            height: 52px;
            font-size: 16px;
            padding: 12px 16px;
        }

        .form-control::placeholder {
            color: #999;
            opacity: 1;
        }

        input[type="file"].form-control {
            height: auto;
            padding: 8px 10px;
            font-size: 15px;
            color: #999;
        }

        .file-label {
            text-align: left;
            font-weight: 500;
            margin-bottom: 6px;
            color: #999;
        }

        button {
            background-color: #d21404;
            color: white;
            width: 100%;
            padding: 12px;
            border: none;
            font-size: 16px;
            margin-top: 15px;
            border-radius: 7px;
            cursor: pointer;
        }

        button:hover {
            background-color: #a91b0d;
        }

        .login-link {
            margin-top: 20px;
        }

        .login-link a {
            text-decoration: underline;
            color: black;
        }

        .login-link a:hover {
            color: red;
        }
    </style>
</head>

<body>

    <div class="navbar">
        <div class="title">
            <img src="/images/matchmove.png" alt="Matchmove" class="logo">
        </div>
    </div>

    <div class="signup-section">

        <h2 class="text-center mb-4">Create Account</h2>

        <% if (typeof messages !== 'undefined' && messages.length > 0) { %>
            <div class="alert alert-danger text-start">
                <% messages.forEach(function(message) { %>
                    <p><%= message %></p>
                <% }); %>
            </div>
        <% } %>

        <form action="/register" method="POST" enctype="multipart/form-data">
            <div class="mb-3">
                <input 
                    type="text"
                    id="userName"
                    name="userName"
                    class="form-control"
                    placeholder="Enter a Username"
                    required>
            </div>

            <div class="mb-3">
                <input 
                    type="email"
                    id="userEmail"
                    name="userEmail"
                    class="form-control"
                    placeholder="Enter Email Address"
                    required>
            </div>

            <div class="mb-3">
                <input 
                    type="password"
                    id="userPassword"
                    name="userPassword"
                    class="form-control"
                    placeholder="Enter a Password"
                    required>
            </div>

            <div class="mb-3 text-start">
                <div class="file-label">Profile Picture (optional)</div>
                <input 
                    type="file"
                    id="profilePic"
                    name="profilePic"
                    class="form-control"
                    accept="image/*">
            </div>

            <button type="submit">Register</button>
        </form>

        <div class="login-link">
            Already have an account?
            <a href="/login"><b><u>Login</u></b></a>
        </div>

    </div>

</body>

</html>