<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <title>Exception Records – Returned To Sender</title>

    <!-- Bootstrap -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css">

    <!-- DataTables -->
    <link rel="stylesheet" href="https://cdn.datatables.net/1.13.6/css/dataTables.bootstrap5.min.css">

    <style>
        body {
            background-color: #f4f6f8;
        }
        .card {
            border-radius: 8px;
            box-shadow: 0 2px 6px rgba(0,0,0,0.1);
        }
    </style>
</head>

<body>
<%- include('partial/navbar') %>
<%- include('partial/sidebar') %>

<div class="container mt-4">

    <h2 class="text-center mb-3">Exception Records</h2>
    <p class="text-center text-muted">
        Showing ONLY rows where Status =
        <strong>Returned To Sender</strong>
    </p>

    <div class="card p-3">
        <div class="table-responsive">
            <table id="exceptionTable" class="table table-bordered table-hover table-sm">
                <thead>
                    <tr>
                        <% if (data.length > 0) { %>
                            <% Object.keys(data[0]).forEach(key => { %>
                                <th><%= key %></th>
                            <% }) %>
                        <% } else { %>
                            <th>No Returned To Sender records found</th>
                        <% } %>
                    </tr>
                </thead>

                <tbody>
                    <% data.forEach(row => { %>
                        <tr>
                            <% Object.values(row).forEach(value => { %>
                                <td><%= value %></td>
                            <% }) %>
                        </tr>
                    <% }) %>
                </tbody>
            </table>
        </div>
    </div>
</div>

<!-- JS -->
<script src="https://code.jquery.com/jquery-3.7.1.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
<script src="https://cdn.datatables.net/1.13.6/js/jquery.dataTables.min.js"></script>
<script src="https://cdn.datatables.net/1.13.6/js/dataTables.bootstrap5.min.js"></script>

<script>
    $(document).ready(function () {
        $('#exceptionTable').DataTable({
            pageLength: 10,
            ordering: true,
            searching: true
        });
    });
</script>

</body>
</html>
