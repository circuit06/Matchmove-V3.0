<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <title>Exception Records – Returned To Sender</title>

    <!-- Bootstrap -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css">

    <!-- DataTables -->
    <link rel="stylesheet" href="https://cdn.datatables.net/1.13.6/css/dataTables.bootstrap5.min.css">

    <style>

        .table-responsive {
        overflow-x: auto;
        }

        html, body {
            max-width: 100vw;
            overflow-x: hidden;
            height: 100%;
            background: #eef1f5;
        }

        .dataTables_wrapper,
        .dataTables_scroll,
        .dataTables_scrollBody {
        max-width: 100%;
        overflow-x: auto;
        }

        .status-badge,
        .action-btn {
            white-space: nowrap;
        }

        .modal {
        overflow-y: auto;
        }

        /* Lock page scrolling when modal is open */
        body.modal-open {
        overflow: hidden;
        }

        body {
            background: #eef1f5;
            font-family: system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
        }

        /* Frosted Card */
        .glass-card {
            background: rgba(255, 255, 255, 0.55);
            backdrop-filter: blur(15px);
            border-radius: 20px;
            padding: 25px;
            box-shadow: 0 8px 25px rgba(0, 0, 0, 0.08);
            border: 1px solid rgba(255, 0, 0, 0.15);
        }

        #exceptionTable thead th {
            background: #fff5f5;
            color: #b40000;
            font-weight: 700;
            border-bottom: 2px solid #e2b4b4 !important;
        }

        #exceptionTable tbody td {
            border-bottom: 1px solid #f4c7c7 !important;
        }

        #exceptionTable tbody tr:hover {
            background: #fffafa !important;
            box-shadow: 0 3px 10px rgba(255, 0, 0, 0.15);
            transform: scale(1.01);
            border-radius: 12px;
        }

        .exception-table-wrapper {
            overflow-x: auto;
            width: 100%;
        }

        .action-btn {
            padding: 4px 10px;
            border-radius: 8px;
            font-size: 0.8rem;
            margin-right: 4px;
            cursor: pointer;
        }

        .view-btn {
            background: #e6f2ff;
            border: 1px solid #97c3ff;
            color: #004a99;
        }

        .edit-btn {
            background: #fff0e0;
            border: 1px solid #ffbe78;
            color: #b85c00;
        }

        /* Status badge */
        .status-badge {
            background: #ffe5e5;
            color: #b40000;
            padding: 4px 12px;
            border-radius: 12px;
            font-weight: 600;
            font-size: 0.8rem;
            display: inline-block;
            text-align: center;
            min-width: 140px;
        }


        /* Make the edit modal scrollable */
        #editModal .modal-dialog {
            max-height: 90vh; 
        }

        #editModal .modal-content {
            max-height: 90vh;
            display: flex;
            flex-direction: column;
        }

        #editModal .modal-body {
            overflow-y: auto;
            padding-right: 10px;
            flex: 1;
        }

        /* FORCE modal above everything */
        .modal {
        z-index: 9999;
        }

        .modal-backdrop {
        z-index: 9998;
        }

    </style>
</head>

<body>

<%- include('partial/navbar') %>
<%- include('partial/sidebar') %>

<div class="container mt-4">

    <h2 class="text-center mb-2">Exception Records</h2>
    <p class="text-center text-muted mb-4">
        Showing ONLY rows where Status =
        <strong>Returned To Sender</strong>
    </p>

    <div class="glass-card">
        <div class="table-responsive exception-table-wrapper">
            <table id="exceptionTable" class="table table-hover table-sm">
                <thead>
                    <tr id="headRow">
                        <th class="text-muted">Loading...</th>
                    </tr>
                </thead>
                <tbody id="bodyRows"></tbody>
            </table>
        </div>
    </div>
</div>

<!-- VIEW MODAL -->
<div class="modal fade" id="viewModal" tabindex="-1">
  <div class="modal-dialog modal-dialog-centered modal-dialog-scrollable">
    <div class="modal-content">
      <div class="modal-header">
        <h5 class="modal-title">Record Details</h5>
        <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
      </div>
      <div class="modal-body p-3">
        <div id="viewContent" class="mt-2"></div>
      </div>
      <div class="modal-footer">
        <button class="btn btn-secondary" data-bs-dismiss="modal">Close</button>
      </div>
    </div>
  </div>
</div>

<!-- EDIT MODAL -->
<div class="modal fade" id="editModal" tabindex="-1" aria-hidden="true">
  <div class="modal-dialog modal-lg modal-dialog-centered modal-dialog-scrollable">
    <div class="modal-content">

      <div class="modal-header">
        <h5 class="modal-title">Edit Record</h5>
        <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
      </div>

      <div class="modal-body">
        <form id="editForm"></form>
      </div>

      <div class="modal-footer">
        <button class="btn btn-primary" onclick="saveEdit()">Save</button>
        <button class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
      </div>

    </div>
  </div>
</div>


<script src="https://code.jquery.com/jquery-3.7.1.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
<script src="https://cdn.datatables.net/1.13.6/js/jquery.dataTables.min.js"></script>
<script src="https://cdn.datatables.net/1.13.6/js/dataTables.bootstrap5.min.js"></script>

<script>
let auditData = JSON.parse(localStorage.getItem("auditDataStore")) || [];
let currentEditRow = null;

// ONLY THESE FIELDS CAN BE EDITED
const editableFields = [
    "NAME",
    "ADDRESS 1",
    "ADDRESS 2",
    "ADDRESS 3",
    "ADDRESS 4",
    "MOBILE NO."
];

$(document).ready(function () {

    const headRow = document.getElementById("headRow");
    const bodyRows = document.getElementById("bodyRows");

    if (auditData.length === 0) {
        headRow.innerHTML = "<th>No data found — upload Excel in Dashboard first</th>";
        return;
    }

    const statusColumn = Object.keys(auditData[0]).find(k =>
        k.toLowerCase().includes("status")
    );

    const filtered = auditData.filter(row =>
        row[statusColumn] &&
        String(row[statusColumn]).trim().toLowerCase() === "returned to sender"
    );

    headRow.innerHTML = "";
    bodyRows.innerHTML = "";

    Object.keys(filtered[0]).forEach(key => {
        headRow.innerHTML += `<th>${key}</th>`;
    });
    headRow.innerHTML += `<th>Actions</th>`;

    filtered.forEach(row => {
        const realIndex = auditData.indexOf(row);
        let rowHTML = "<tr>";

        Object.entries(row).forEach(([key, value]) => {
            if (key.toLowerCase().includes("status")) {
                rowHTML += `<td><span class="status-badge">${value}</span></td>`;
            } else {
                rowHTML += `<td>${value ?? ""}</td>`;
            }
        });

        rowHTML += `
          <td>
            <button class="action-btn view-btn" onclick="viewRow(${realIndex})">👁 View</button>
            <button class="action-btn edit-btn" onclick='editRow(${JSON.stringify(row)})'>✏️ Edit </button>
          </td>
        </tr>
        `;

        bodyRows.innerHTML += rowHTML;
    });

    $('#exceptionTable').DataTable({
        pageLength: 10,
        ordering: true,
        searching: true,
        scrollX: true
    });
});


/* VIEW */
function viewRow(i) {
    const row = auditData[i];
    let html = "";

    Object.keys(row).forEach(key => {
        html += `<p><strong>${key}:</strong> ${row[key]}</p>`;
    });

    document.getElementById("viewContent").innerHTML = html;
    bootstrap.Modal.getOrCreateInstance(
        document.getElementById("viewModal")
    ).show();
}

/* ✅ FINAL EDIT FORM — GUARANTEED */
function editRow(row) {
    console.log("🔍 editRow called with:", row);

    if (!row) {
        console.error("❌ Row is null/undefined!");
        return;
    }

    currentEditRow = row;
    
    let html = "";

    Object.keys(row).forEach(key => {
        const value = row[key] ?? "";
        const editable = editableFields.includes(key.trim().toUpperCase());

        if (editable) {
            html += `
                <div class="mb-3">
                    <label class="form-label fw-semibold">${key}</label>
                    <input class="form-control" name="${key}" value="${value}">
                </div>
            `;
        } else {
            html += `
                <div class="mb-3">
                    <label class="form-label fw-semibold">${key}</label>
                    <div class="form-control bg-light">${value}</div>
                </div>
            `;
        }
    });

    console.log("📝 Form HTML generated");
    document.getElementById("editForm").innerHTML = html;
    console.log("✅ Form HTML injected");

    const modalEl = document.getElementById("editModal");
    console.log("🎯 Modal element found:", modalEl);
    
    if (!modalEl) {
        console.error("❌ editModal element not found!");
        return;
    }

    try {
        const modal = bootstrap.Modal.getOrCreateInstance(modalEl);
        console.log("🎭 Bootstrap Modal instance created");
        modal.show();
        console.log("✅ Modal shown!");
    } catch (e) {
        console.error("❌ Error showing modal:", e);
    }
}



/* SAVE */
function saveEdit() {
    const inputs = document.querySelectorAll("#editForm input");

    inputs.forEach(input => {
        currentEditRow[input.name] = input.value;
    });

    // Update the matching object in auditData
    const index = auditData.findIndex(r => r === currentEditRow);
    if (index !== -1) {
        auditData[index] = currentEditRow;
    }

    localStorage.setItem("auditDataStore", JSON.stringify(auditData));

    bootstrap.Modal.getInstance(
        document.getElementById("editModal")
    ).hide();

    location.reload();
}


</script>

</body>
</html>
