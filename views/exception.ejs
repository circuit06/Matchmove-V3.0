<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <title>Exception Records – Returned To Sender</title>

    <!-- Bootstrap -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css">

    <!-- DataTables -->
    <link rel="stylesheet" href="https://cdn.datatables.net/1.13.6/css/dataTables.bootstrap5.min.css">

    <style>
        body {
            background: #eef1f5;
            backdrop-filter: blur(5px);
            font-family: system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
        }

        /* ----- FROSTED GLASS CARD ----- */
        .glass-card {
            background: rgba(255, 255, 255, 0.55);
            backdrop-filter: blur(15px);
            -webkit-backdrop-filter: blur(15px);
            border-radius: 20px;
            padding: 25px;
            box-shadow: 0 8px 25px rgba(0, 0, 0, 0.08);
            border: 1px solid rgba(255, 255, 255, 0.45);
        }

        /* Title styling */
        h2 {
            font-weight: 700;
            letter-spacing: -0.5px;
        }

        /* Datatable styling */
        table.dataTable thead th {
            background: rgba(255, 255, 255, 0.85);
            backdrop-filter: blur(10px);
            font-weight: 600;
            border-bottom: 2px solid #ddd !important;
        }

        table.dataTable tbody tr {
            background-color: rgba(255, 255, 255, 0.6);
        }

        table.dataTable tbody tr:hover {
            background-color: rgba(255, 255, 255, 0.9);
            transition: 0.2s ease;
        }

        th, td {
            vertical-align: middle !important;
        }

        /* Rounded search box + select */
        .dataTables_filter input,
        .dataTables_length select {
            border-radius: 10px !important;
            border: 1px solid #ccc;
            padding: 6px 10px;
        }

        /* Center wrapper */
        .container {
            max-width: 1250px;
        }

        /* Bigger & Stronger Hover Effect */
#exceptionTable tbody tr {
    transition: all 0.25s ease;
}

#exceptionTable tbody tr:hover {
    background: #ffffff !important;
    transform: scale(1.03); /* 👈 super obvious hover size */
    box-shadow: 0 6px 18px rgba(0, 0, 0, 0.18);
    z-index: 10;
    position: relative;
    border-radius: 12px;
}




    </style>
</head>

<body>

<%- include('partial/navbar') %>
<%- include('partial/sidebar') %>

<div class="container mt-4">

    <h2 class="text-center mb-2">Exception Records</h2>
    <p class="text-center text-muted mb-4">
        Showing ONLY rows where Status =
        <strong>Returned To Sender</strong>
    </p>

    <!-- Frosted Glass Card -->
    <div class="glass-card">
        <div class="table-responsive">
            <table id="exceptionTable" class="table table-hover table-sm">
                <thead>
                    <tr id="headRow">
                        <th class="text-muted">Loading...</th>
                    </tr>
                </thead>
                <tbody id="bodyRows"></tbody>
            </table>
        </div>
    </div>
</div>

<!-- JS -->
<script src="https://code.jquery.com/jquery-3.7.1.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
<script src="https://cdn.datatables.net/1.13.6/js/jquery.dataTables.min.js"></script>
<script src="https://cdn.datatables.net/1.13.6/js/dataTables.bootstrap5.min.js"></script>

<script>

    // Read the correct stored table data
    let auditData = JSON.parse(localStorage.getItem("auditDataStore")) || [];

    $(document).ready(function () {

        const headRow = document.getElementById("headRow");
        const bodyRows = document.getElementById("bodyRows");

        if (auditData.length === 0) {
            headRow.innerHTML =
                "<th>No data found — upload Excel in Dashboard first</th>";
            return;
        }

        // Auto-detect the Status column
        const statusColumn = Object.keys(auditData[0]).find(k =>
            k.toLowerCase().includes("status")
        );

        // Filter status = Returned To Sender
        const filtered = auditData.filter(row =>
            row[statusColumn] &&
            String(row[statusColumn]).trim().toLowerCase() === "returned to sender"
        );

        headRow.innerHTML = "";
        bodyRows.innerHTML = "";

        if (filtered.length === 0) {
            headRow.innerHTML = "<th>No Returned To Sender records found</th>";
        } else {
            // Header
            Object.keys(filtered[0]).forEach(key => {
                headRow.innerHTML += `<th>${key}</th>`;
            });

            // Body rows
            filtered.forEach(row => {
                let rowHTML = "<tr>";
                Object.values(row).forEach(v => {
                    rowHTML += `<td>${v}</td>`;
                });
                rowHTML += "</tr>";
                bodyRows.innerHTML += rowHTML;
            });
        }

        // Datatable activation
        $('#exceptionTable').DataTable({
            pageLength: 10,
            ordering: true,
            searching: true
        });
    });

</script>

</body>
</html>
