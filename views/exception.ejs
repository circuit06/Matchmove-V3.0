<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <title>Exception Records – Returned To Sender</title>

    <!-- Bootstrap -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css">

    <!-- DataTables -->
    <link rel="stylesheet" href="https://cdn.datatables.net/1.13.6/css/dataTables.bootstrap5.min.css">

    <style>
        body {
            background-color: #f4f6f8;
        }
        .card {
            border-radius: 8px;
            box-shadow: 0 2px 6px rgba(0,0,0,0.1);
        }
    </style>
</head>

<body>
<%- include('partial/navbar') %>
<%- include('partial/sidebar') %>

<div class="container mt-4">

    <h2 class="text-center mb-3">Exception Records</h2>
    <p class="text-center text-muted">
        Showing ONLY rows where Status =
        <strong>Returned To Sender</strong>
    </p>

    <div class="card p-3">
        <div class="table-responsive">
            <table id="exceptionTable" class="table table-bordered table-hover table-sm">
                <thead>
                    <tr id="headRow">
                        <th class="text-muted">Loading...</th>
                    </tr>
                </thead>
                <tbody id="bodyRows"></tbody>
            </table>
        </div>
    </div>
</div>

<!-- JS -->
<script src="https://code.jquery.com/jquery-3.7.1.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
<script src="https://cdn.datatables.net/1.13.6/js/jquery.dataTables.min.js"></script>
<script src="https://cdn.datatables.net/1.13.6/js/dataTables.bootstrap5.min.js"></script>

<script>

    // ⭐ FIXED: Read from the correct localStorage key
    let auditData = JSON.parse(localStorage.getItem("auditDataStore")) || [];

    $(document).ready(function () {

        if (auditData.length === 0) {
            document.getElementById("headRow").innerHTML =
                "<th>No data found — upload Excel in Dashboard first</th>";
            return;
        }

        const statusColumn = Object.keys(auditData[0]).find(k =>
            k.toLowerCase().includes("status")
        );

        const filtered = auditData.filter(row =>
            row[statusColumn] &&
            String(row[statusColumn]).trim().toLowerCase() === "returned to sender"
        );

        const headRow = document.getElementById("headRow");
        const bodyRows = document.getElementById("bodyRows");

        headRow.innerHTML = "";
        bodyRows.innerHTML = "";

        if (filtered.length === 0) {
            headRow.innerHTML = "<th>No Returned To Sender records found</th>";
        } else {
            // Create header
            Object.keys(filtered[0]).forEach(key => {
                headRow.innerHTML += `<th>${key}</th>`;
            });

            // Create body
            filtered.forEach(row => {
                let rowHTML = "<tr>";
                Object.values(row).forEach(v => {
                    rowHTML += `<td>${v}</td>`;
                });
                rowHTML += "</tr>";
                bodyRows.innerHTML += rowHTML;
            });
        }

        // Apply DataTable
        $('#exceptionTable').DataTable({
            pageLength: 10,
            ordering: true,
            searching: true
        });
    });

</script>

</body>
</html>
