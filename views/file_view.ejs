<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <title>Excel View</title>

  <!-- Bootstrap + DataTables -->
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css">
  <link rel="stylesheet" href="https://cdn.datatables.net/1.13.6/css/dataTables.bootstrap5.min.css">

  <style>
    table.dataTable tbody td { white-space: nowrap; }
    .table-responsive { max-height: 70vh; overflow: auto; }
    thead th { position: sticky; top: 0; z-index: 2; }
  </style>
</head>

<body>
  <%- include('partial/navbar') %>
  <%- include('partial/sidebar') %>

  <div class="container mt-4">
    <div class="d-flex align-items-center justify-content-between mb-2">
      <div>
        <h3 class="mb-1">Excel View</h3>
        <p class="text-muted mb-0">
          File: <strong><%= fileMeta?.filename || 'Unknown' %></strong>
          | Rows: <strong><%= fileMeta?.row_count || 0 %></strong>
          | Upload ID: <strong><%= fileMeta?.id || fileId %></strong>
        </p>
      </div>
    </div>

    <div class="card p-3">
      <div class="table-responsive">
        <table id="excelTable" class="table table-bordered table-hover table-sm">
          <thead class="table-dark">
            <tr id="tableHead"></tr>
          </thead>
          <tbody id="tableBody"></tbody>
        </table>
      </div>
    </div>
  </div>

  <!-- JS libraries -->
  <script src="https://code.jquery.com/jquery-3.7.1.min.js"></script>
  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
  <script src="https://cdn.datatables.net/1.13.6/js/jquery.dataTables.min.js"></script>
  <script src="https://cdn.datatables.net/1.13.6/js/dataTables.bootstrap5.min.js"></script>

  <!-- Server-side data (EJS) -->
  <script id="excel-data" type="application/json">
    <%- JSON.stringify(rows || []) %>
  </script>

  <!-- Client-side JS (pure JavaScript) -->
  <script>
    const data = JSON.parse(document.getElementById("excel-data").textContent);

    function buildTable(rows) {
      const head = document.getElementById("tableHead");
      const body = document.getElementById("tableBody");

      head.innerHTML = "";
      body.innerHTML = "";

      if (!rows.length) {
        head.innerHTML = `<th>No data</th>`;
        return;
      }

      const keys = Object.keys(rows[0]);

      keys.forEach(k => {
        const th = document.createElement("th");
        th.textContent = k;
        head.appendChild(th);
      });

      rows.forEach(r => {
        const tr = document.createElement("tr");
        keys.forEach(k => {
          const td = document.createElement("td");
          td.textContent = r[k] ?? "";
          tr.appendChild(td);
        });
        body.appendChild(tr);
      });

      // Prevent DataTables "reinitialise" error if you reload table
      if ($.fn.DataTable.isDataTable('#excelTable')) {
        $('#excelTable').DataTable().destroy();
      }

      $('#excelTable').DataTable({
        pageLength: 25,
        scrollX: true,
        ordering: true
      });
    }

    $(document).ready(function () {
      buildTable(data);
    });
  </script>

</body>
</html>
