<style>
  #sidebar {
    height: 100%;
    width: 0;
    position: fixed;
    z-index: 999;
    top: 0;
    left: 0;
    background-color: white;
    overflow-x: hidden;
    transition: 0.3s;
    padding-top: 60px;
    box-shadow: 2px 0 10px rgba(0, 0, 0, 0.1);
  }

  #sidebar a {
    padding: 12px 25px;
    text-decoration: none;
    font-size: 18px;
    color: black;
    display: block;
  }

  #sidebar a:hover {
    background: #f2f2f2;
  }

  #closeBtn {
    position: absolute;
    top: 15px;
    right: 20px;
    font-size: 30px;
    cursor: pointer;
  }
</style>

<div id="sidebar">
  <span id="closeBtn">&times;</span>

  <a href="/dashboard">Dashboard</a>
  <a href="/deliveryorder">Delivery Orders</a>
  <a href="/exception">Exceptions️‼️</a>
  <a href="/profile">My Profile</a>

  <a href="/logout" style="color: red; font-weight: 600;">Logout</a>
</div>

<script>
  const sidebar = document.getElementById("sidebar");
  const menuIcon = document.getElementById("menuIcon");
  const closeBtn = document.getElementById("closeBtn");

  menuIcon.onclick = () => {
    sidebar.style.width = "250px";
  };

  closeBtn.onclick = () => {
    sidebar.style.width = "0";
  };
</script>
