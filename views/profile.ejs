<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>

    <title>My Profile</title>

    <style>
        body {
            font-family: "Helvetica World", sans-serif;
            margin: 0;
            padding: 0;
            background-color: #f9f9f9;
        }

        /* Main content wrapper (so it doesn’t clash with sidebar) */
        .main-content {
            padding: 80px 20px 20px; /* top space for navbar */
        }

        .profile-wrapper {
            max-width: 600px;
            margin: 0 auto;
        }

        .profile-card {
            background-color: #fff;
            border-radius: 10px;
            padding: 25px 20px;
            box-shadow: 0 2px 8px rgba(0, 0, 0, 0.08);
        }

        .profile-title {
            text-align: center;
            margin-bottom: 25px;
        }

        .profile-label {
            font-weight: 600;
            color: #555;
        }

        .profile-value {
            font-weight: 500;
        }

        .divider {
            border-top: 1px solid #eee;
            margin: 10px 0 15px 0;
        }
    </style>
</head>

<body>

    <!-- Navbar and Sidebar Partials -->
    <%- include('partial/navbar') %>
    <%- include('partial/sidebar') %>

    <!-- Main Profile Content -->
    <div class="main-content">
        <div class="profile-wrapper">
            <div class="profile-card">
                <h3 class="profile-title">My Profile</h3>

                <div class="mb-3">
                    <div class="profile-label">Username</div>
                    <div class="profile-value"><%= userName %></div>
                </div>

                <div class="divider"></div>

                <div class="mb-3">
                    <div class="profile-label">Email</div>
                    <div class="profile-value"><%= userEmail %></div>
                </div>

                <div class="divider"></div>

                <div class="mb-1">
                    <div class="profile-label">Password</div>
                    <!-- For security, just show masked password -->
                    <div class="profile-value">********</div>
                </div>
            </div>
        </div>
    </div>

</body>

</html>
