<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>My Profile</title>

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">

    <style>
        body {
            background: #f4f6f8;
            font-family: "Segoe UI", Tahoma, Geneva, Verdana, sans-serif;
        }

        .page-wrapper {
            margin-top: 40px;
            display: flex;
            justify-content: center;
            width: 100%;
        }

        .profile-container {
            width: 100%;
            max-width: 1100px;
        }

        .profile-title {
            text-align: center;
            font-size: 32px;
            font-weight: 700;
            color: #000;
            margin-bottom: 30px;
        }

        .profile-layout {
            display: flex;
            gap: 50px;
            width: 100%;
        }

        .profile-avatar {
            width: 280px;
            height: 280px;
            object-fit: cover;
            border-radius: 10px;
        }

        .profile-field {
            margin-bottom: 20px;
        }

        .profile-field label {
            font-weight: 600;
            font-size: 18px;
            margin-bottom: 6px;
        }

        .profile-field input {
            padding: 14px;
            font-size: 20px;
        }

        .edit-btn-wrapper {
            margin-top: 40px;
            text-align: center;
        }

        .btn-edit {
            background: #d21404;
            color: white;
            padding: 12px 40px;
            border: none;
            font-size: 20px;
            font-weight: 600;
            border-radius: 6px;
        }

        .btn-edit:hover {
            background: #b01003;
        }

        @media (max-width: 768px) {
            .profile-layout {
                flex-direction: column;
                align-items: center;
                gap: 20px;
            }

            .profile-avatar {
                width: 220px;
                height: 220px;
            }
        }
    </style>
</head>

<body>
    <%- include('partial/navbar') %>
    <%- include('partial/sidebar') %>

    <div class="page-wrapper">
        <div class="profile-container">

            <div class="profile-title">My Profile</div>
            <div class="profile-layout">

                <% if (user.profile_picture && user.profile_picture !== 'default.png') { %>
                    <img src="/uploads/<%= user.profile_picture %>" class="profile-avatar">

                    <div style="flex: 1;">
                <% } else { %>

                    <div style="flex: 1; max-width: 650px; margin: 0 auto;">
                <% } %>

                        <div id="viewMode">
                            <div class="profile-field">
                                <label>Username</label>
                                <input class="form-control" value="<%= user.username %>" disabled>
                            </div>

                            <div class="profile-field">
                                <label>Email</label>
                                <input class="form-control" value="<%= user.email %>" disabled>
                            </div>

                            <div class="profile-field">
                                <label>Password</label>
                                <input class="form-control" value="******" disabled>
                            </div>
                        </div>

                        <div id="editMode" style="display:none;">
                            <form action="/profile" method="POST" enctype="multipart/form-data">

                                <div class="profile-field">
                                    <label>Username</label>
                                    <input type="text" class="form-control" name="userName" value="<%= user.username %>">
                                </div>

                                <div class="profile-field">
                                    <label>Email</label>
                                    <input type="email" class="form-control" name="userEmail" value="<%= user.email %>">
                                </div>

                                <div class="profile-field">
                                    <label>New Password</label>
                                    <input type="password" class="form-control" name="userPassword" placeholder="Leave blank to keep current password">
                                </div>

                                <div class="profile-field">
                                    <label>Profile Picture</label>
                                    <input type="file" class="form-control" name="profilePic" accept="image/*">
                                </div>

                                <div class="d-flex gap-3">
                                    <button type="submit" class="btn btn-success w-50">Save</button>
                                    <button type="button" class="btn btn-danger w-50" onclick="cancelEdit()">Cancel</button>
                                </div>

                            </form>
                        </div>

                    </div>

            </div>

            <div class="edit-btn-wrapper" id="editBtnArea">
                <button class="btn-edit" onclick="enableEdit()">Edit Profile</button>
            </div>

        </div>
    </div>

    <script>
        function enableEdit() {
            document.getElementById("viewMode").style.display = "none";
            document.getElementById("editMode").style.display = "block";
            document.getElementById("editBtnArea").style.display = "none";
        }

        function cancelEdit() {
            document.getElementById("editMode").style.display = "none";
            document.getElementById("viewMode").style.display = "block";
            document.getElementById("editBtnArea").style.display = "block";
        }
    </script>

</body>
</html>