<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>My Profile</title>

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">

    <style>
        body {
            background: #f4f6f8;
            font-family: "Segoe UI", Tahoma, Geneva, Verdana, sans-serif;
        }

        .page-wrapper {
            margin-top: 30px;
            padding-bottom: 40px;
            display: flex;
            justify-content: center;
            width: 100%;
            min-height: calc(100vh - 120px);
        }

        .profile-container {
            width: 100%;
            max-width: 1000px;
        }

        .profile-title {
            text-align: center;
            font-size: 28px;
            font-weight: 700;
            margin-bottom: 20px;
        }

        .profile-layout {
            display: flex;
            gap: 40px;
        }

        .profile-avatar {
            width: 240px;
            height: 240px;
            object-fit: cover;
            border-radius: 10px;
        }

        .profile-field {
            margin-bottom: 16px;
        }

        .profile-field label {
            font-weight: 600;
            margin-bottom: 4px;
        }

        .edit-btn-wrapper {
            margin-top: 30px;
            text-align: center;
        }

        .btn-edit {
            background: #d21404;
            color: white;
            padding: 10px 32px;
            font-size: 18px;
            font-weight: 600;
            border-radius: 6px;
            border: none;
        }

        .btn-edit:hover {
            background: #b01003;
        }

        @media (max-width: 768px) {
            .profile-layout {
                flex-direction: column;
                align-items: center;
                gap: 20px;
            }

            .profile-avatar {
                width: 200px;
                height: 200px;
            }
        }
    </style>
</head>

<body>
    <%- include('partial/navbar') %>
    <%- include('partial/sidebar') %>


    <div class="page-wrapper">
        <div class="profile-container">

            <% if (messages && messages.length > 0) { %>
                <div class="alert alert-success text-center">
                    <% messages.forEach(m => { %>
                        <div><%= m %></div>
                    <% }) %>
                </div>
            <% } %>

            <% if (errors && errors.length > 0) { %>
                <div class="alert alert-danger text-center">
                    <% errors.forEach(e => { %>
                        <div><%= e %></div>
                    <% }) %>
                </div>
            <% } %>

            <div class="profile-title">My Profile</div>

            <% const hasCustomPic = user.profile_picture && user.profile_picture !== 'default.png'; %>

            <div class="profile-layout">

                <% if (hasCustomPic) { %>
                    <img src="/uploads/<%= user.profile_picture %>" class="profile-avatar">
                    <div style="flex:1;">
                <% } else { %>
                    <div style="flex:1; max-width:650px; margin:0 auto;">
                <% } %>

                    <!-- VIEW MODE -->
                    <div id="viewMode">
                        <div class="profile-field">
                            <label>Username</label>
                            <input class="form-control" value="<%= user.username %>" disabled>
                        </div>

                        <div class="profile-field">
                            <label>Email</label>
                            <input class="form-control" value="<%= user.email %>" disabled>
                        </div>

                        <div class="profile-field">
                            <label>Password</label>
                            <input class="form-control" value="******" disabled>
                        </div>
                    </div>

                    <!-- EDIT MODE -->
                    <div id="editMode" style="display:none;">
                        <form action="/profile" method="POST" enctype="multipart/form-data">

                            <div class="profile-field">
                                <label>Username</label>
                                <input type="text" class="form-control" name="userName" value="<%= user.username %>">
                            </div>

                            <div class="profile-field">
                                <label>Email</label>
                                <input type="email" class="form-control" name="userEmail" value="<%= user.email %>">
                            </div>

                            <div class="profile-field">
                                <label>New Password</label>
                                <input type="password" class="form-control" name="userPassword" placeholder="Leave blank to keep current password">
                            </div>

                            <div class="profile-field">
                                <label>Profile Picture</label>
                                <input type="file" class="form-control" name="profilePic" accept="image/*">
                            </div>

                            <% if (hasCustomPic) { %>
                                <div class="form-check mb-3">
                                    <input class="form-check-input"
                                           type="checkbox"
                                           id="removeProfilePic"
                                           name="removeProfilePic"
                                           value="1">
                                    <label class="form-check-label" for="removeProfilePic">
                                        Remove current profile picture
                                    </label>
                                </div>
                            <% } %>

                            <div class="d-flex gap-3">
                                <button type="submit" class="btn btn-success w-50">Save</button>
                                <button type="button" class="btn btn-danger w-50" onclick="cancelEdit()">Cancel</button>
                            </div>
                        </form>
                    </div>

                </div>
            </div>

            <div class="edit-btn-wrapper" id="editBtnArea">
                <button class="btn-edit" onclick="enableEdit()">Edit Profile</button>
            </div>

        </div>
    </div>

    <script>
        function enableEdit() {
            document.getElementById("viewMode").style.display = "none";
            document.getElementById("editMode").style.display = "block";
            document.getElementById("editBtnArea").style.display = "none";

            const cb = document.getElementById("removeProfilePic");
            if (cb) cb.checked = false;
        }

        function cancelEdit() {
            document.getElementById("editMode").style.display = "none";
            document.getElementById("viewMode").style.display = "block";
            document.getElementById("editBtnArea").style.display = "block";
        }
    </script>

</body>
</html>
