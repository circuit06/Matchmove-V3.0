<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>My Profile</title>

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">

    <style>
        body {
            background: #eef1f5;
            font-family: "Segoe UI", Tahoma, Geneva, Verdana, sans-serif;
        }

        .page-wrapper {
            margin-left: 0;
            padding: 40px 20px;
            display: flex;
            justify-content: center;
            align-items: center;
            min-height: calc(100vh - 80px);
        }

        .profile-card {
            width: 100%;
            max-width: 550px;
            background: #fff;
            border-radius: 16px;
            padding: 35px;
            box-shadow: 0px 4px 18px rgba(0,0,0,0.08);
            animation: fadeIn 0.4s ease;
        }

        @keyframes fadeIn {
            from {opacity: 0; transform: translateY(10px);}
            to {opacity: 1; transform: translateY(0);}
        }

        /* CENTER THE PROFILE HEADER */
        .profile-title, 
        .profile-subtitle {
            text-align: center;
        }

        .profile-title {
            font-size: 28px;
            font-weight: 700;
            color: #333;
            margin-bottom: 8px;
        }

        .profile-subtitle {
            color: #6c757d;
            margin-bottom: 25px;
        }

        .profile-field {
            margin-bottom: 18px;
        }

        .label {
            font-weight: 600;
            font-size: 14px;
            text-transform: uppercase;
            margin-bottom: 5px;
        }

        .value {
            font-size: 17px;
            padding: 12px 15px;
            background: #f4f6f8;
            border-radius: 10px;
        }

        .btn-row {
            margin-top: 25px;
        }

        .alert {
            max-width: 550px;
            margin-bottom: 20px;
        }

        /* ---------- Custom Buttons ---------- */
        .btn-danger-custom {
            background-color: #d21404;
            color: #fff;
            border: none;
            transition: background-color 0.2s ease, transform 0.1s ease;
        }

        .btn-danger-custom:hover {
            background-color: #a91b0d;
            color: white;
            transform: translateY(-1px);
        }

        .btn-success-custom {
            background-color: #28a745;
            color: #fff;
            border: none;
            transition: background-color 0.2s ease, transform 0.1s ease;
        }

        .btn-success-custom:hover {
            background-color: #218838;
            color: white;
            transform: translateY(-1px);
        }
    </style>
</head>

<body>
    <%- include('partial/navbar') %>
    <%- include('partial/sidebar') %>

    <div class="page-wrapper">

        <% if (messages && messages.length > 0) { %>
            <div class="alert alert-success">
                <% messages.forEach(m => { %><div><%= m %></div><% }) %>
            </div>
        <% } %>

        <% if (errors && errors.length > 0) { %>
            <div class="alert alert-danger">
                <% errors.forEach(e => { %><div><%= e %></div><% }) %>
            </div>
        <% } %>

        <div class="profile-card">
            <div class="profile-title">My Profile</div>

            <!-- VIEW MODE -->
            <div id="viewMode">
                <div class="profile-field">
                    <div class="label">Username</div>
                    <div class="value"><%= user.username %></div>
                </div>

                <div class="profile-field">
                    <div class="label">Email</div>
                    <div class="value"><%= user.email %></div>
                </div>

                <div class="profile-field">
                    <div class="label">Password</div>
                    <div class="value">******</div>
                </div>

                <div class="btn-row">
                    <button class="btn btn-danger-custom w-100" onclick="enableEdit()">Edit Profile</button>
                </div>
            </div>

            <!-- EDIT MODE -->
            <div id="editMode" style="display: none;">
                <form action="/profile" method="POST">

                    <div class="profile-field">
                        <div class="label">Username</div>
                        <input type="text" class="form-control" name="userName" value="<%= user.username %>" required />
                    </div>

                    <div class="profile-field">
                        <div class="label">Email</div>
                        <input type="email" class="form-control" name="userEmail" value="<%= user.email %>" required />
                    </div>

                    <div class="profile-field">
                        <div class="label">New Password</div>
                        <input type="password" class="form-control" name="userPassword" placeholder="Leave blank to keep current password" />
                    </div>

                    <div class="btn-row d-flex gap-2">
                        <button type="submit" class="btn btn-success-custom w-50">Save Changes</button>
                        <button type="button" class="btn btn-danger-custom w-50" onclick="cancelEdit()">Cancel</button>
                    </div>
                </form>
            </div>

        </div>
    </div>

    <script>
        function enableEdit() {
            document.getElementById('viewMode').style.display = 'none';
            document.getElementById('editMode').style.display = 'block';
        }

        function cancelEdit() {
            document.getElementById('editMode').style.display = 'none';
            document.getElementById('viewMode').style.display = 'block';
        }
    </script>
</body>
</html>