<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>My Profile</title>

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">

    <style>
        body {
            background: #eef1f5;
            font-family: "Segoe UI", Tahoma, Geneva, Verdana, sans-serif;
        }

        .page-wrapper {
            margin-left: 0;
            padding: 40px 20px;
            display: flex;
            justify-content: center;
            align-items: center;
            min-height: calc(100vh - 80px);
        }

        .profile-card {
            width: 100%;
            max-width: 950px;
            background: #fff;
            border-radius: 16px;
            padding: 40px 50px;
            box-shadow: 0px 4px 18px rgba(0,0,0,0.08);
            animation: fadeIn 0.4s ease;
        }

        @keyframes fadeIn {
            from {opacity: 0; transform: translateY(10px);}
            to {opacity: 1; transform: translateY(0);}
        }

        .profile-title {
            text-align: center;
            font-size: 32px;
            font-weight: 700;
            color: #000;
            margin-bottom: 10px;
        }

        .profile-layout {
            display: flex;
            gap: 40px;
            align-items: flex-start;
            margin-top: 25px;
        }

        .profile-avatar-wrap {
            flex: 0 0 230px;
            display: flex;
            justify-content: center;
        }

        .profile-avatar {
            width: 230px;
            height: 230px;
            object-fit: cover;
            border-radius: 14px;          /* square-ish like your image */
            border: 2px solid #ddd;
        }

        .profile-main {
            flex: 1;
        }

        .profile-field {
            margin-bottom: 18px;
        }

        .profile-field label {
            font-weight: 600;
            font-size: 16px;
            margin-bottom: 6px;
        }

        .profile-field .form-control {
            padding: 12px 14px;
            font-size: 18px;
        }

        .btn-row {
            margin-top: 30px;
            display: flex;
            justify-content: center;
        }

        .btn-danger-custom {
            background-color: #d21404;
            color: #fff;
            border: none;
            padding: 12px 40px;
            font-size: 18px;
            font-weight: 600;
            border-radius: 4px;
            display: inline-flex;
            align-items: center;
            gap: 8px;
            transition: background-color 0.2s ease, transform 0.1s ease;
        }

        .btn-danger-custom:hover {
            background-color: #a91b0d;
            transform: translateY(-1px);
        }

        .btn-success-custom {
            background-color: #28a745;
            color: #fff;
            border: none;
            transition: background-color 0.2s ease, transform 0.1s ease;
        }

        .btn-success-custom:hover {
            background-color: #218838;
            transform: translateY(-1px);
        }

        @media (max-width: 768px) {
            .profile-card {
                padding: 25px 18px;
            }

            .profile-layout {
                flex-direction: column;
                align-items: center;
            }

            .profile-avatar-wrap {
                flex: 0 0 auto;
                margin-bottom: 20px;
            }

            .profile-avatar {
                width: 180px;
                height: 180px;
            }

            .profile-main {
                width: 100%;
            }
        }
    </style>
</head>

<body>
    <%- include('partial/navbar') %>
    <%- include('partial/sidebar') %>

    <div class="page-wrapper">
        <div class="profile-card">

            <% if (messages && messages.length > 0) { %>
                <div class="alert alert-success">
                    <% messages.forEach(m => { %><div><%= m %></div><% }) %>
                </div>
            <% } %>

            <% if (errors && errors.length > 0) { %>
                <div class="alert alert-danger">
                    <% errors.forEach(e => { %><div><%= e %></div><% }) %>
                </div>
            <% } %>

            <div class="profile-title">My Profile</div>

            <div class="profile-layout">
                <!-- LEFT: PROFILE IMAGE -->
                <div class="profile-avatar-wrap">
                    <% if (user.profile_picture && user.profile_picture !== 'default.png') { %>
                        <img 
                            src="/uploads/<%= user.profile_picture %>" 
                            alt="Profile Picture"
                            class="profile-avatar">
                    <% } else { %>
                        <!-- optional placeholder image -->
                        <img 
                            src="/images/default-avatar.png" 
                            alt="Profile Picture"
                            class="profile-avatar">
                    <% } %>
                </div>

                <!-- RIGHT: FIELDS -->
                <div class="profile-main">
                    <!-- VIEW MODE -->
                    <div id="viewMode">
                        <div class="profile-field">
                            <label>Username</label>
                            <input type="text" class="form-control" value="<%= user.username %>" disabled>
                        </div>

                        <div class="profile-field">
                            <label>Email</label>
                            <input type="email" class="form-control" value="<%= user.email %>" disabled>
                        </div>

                        <div class="profile-field">
                            <label>Password</label>
                            <input type="password" class="form-control" value="******" disabled>
                        </div>

                        <div class="btn-row">
                            <button class="btn btn-danger-custom" onclick="enableEdit()">
                                Edit Profile
                                <span class="ms-1">&#9998;</span> <!-- pencil icon -->
                            </button>
                        </div>
                    </div>

                    <!-- EDIT MODE -->
                    <div id="editMode" style="display:none;">
                        <form action="/profile" method="POST" enctype="multipart/form-data">
                            <div class="profile-field">
                                <label>Username</label>
                                <input type="text" class="form-control" name="userName" value="<%= user.username %>" required />
                            </div>

                            <div class="profile-field">
                                <label>Email</label>
                                <input type="email" class="form-control" name="userEmail" value="<%= user.email %>" required />
                            </div>

                            <div class="profile-field">
                                <label>New Password</label>
                                <input type="password" class="form-control" name="userPassword" placeholder="Leave blank to keep current password" />
                            </div>

                            <div class="profile-field">
                                <label>Profile Picture</label>
                                <input 
                                    type="file" 
                                    name="profilePic" 
                                    class="form-control" 
                                    accept="image/*">
                                <small class="text-muted">Leave empty to keep current picture.</small>
                            </div>

                            <div class="d-flex gap-3 mt-3">
                                <button type="submit" class="btn btn-success-custom w-50">Save Changes</button>
                                <button type="button" class="btn btn-danger-custom w-50" onclick="cancelEdit()">Cancel</button>
                            </div>
                        </form>
                    </div>
                </div>
            </div>

        </div>
    </div>

    <script>
        function enableEdit() {
            document.getElementById('viewMode').style.display = 'none';
            document.getElementById('editMode').style.display = 'block';
        }

        function cancelEdit() {
            document.getElementById('editMode').style.display = 'none';
            document.getElementById('viewMode').style.display = 'block';
        }
    </script>
</body>
</html>
