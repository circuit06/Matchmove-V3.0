<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>

    <title>Login</title>

    <style>
        body {
            font-family: "Helvetica World", sans-serif;
            margin: 0;
            padding: 0;
            height: 100vh;
            display: flex;
            flex-direction: column;
            justify-content: center;
            align-items: center;
            background-color: #f9f9f9;
        }

        .navbar {
            text-align: center;
            margin-bottom: 15px;
        }

        .navbar .title img.logo {
            max-height: 100px;
            width: auto;
        }

        .login-section {
            max-width: 550px;
            width: 100%;
            text-align: center;
        }

        .form-control {
            height: 52px;
            font-size: 16px;
            padding: 12px 16px;
        }

        .form-control::placeholder {
            color: #999;
            opacity: 1;
        }

        .login-btn {
            background-color: #d21404;
            color: white;
            width: 100%;
            padding: 12px;
            border: none;
            font-size: 16px;
            margin-top: 15px;
            border-radius: 7px;
            cursor: pointer;
        }

        .login-btn:hover {
            background-color: #a91b0d;
        }

        .signup-link {
            margin-top: 20px;
            text-align: center;
        }

        .signup-link a {
            text-decoration: underline;
            color: black;
            font-weight: bold;
        }

        .signup-link a:hover {
            color: red;
        }
    </style>
</head>

<body>

    <div class="navbar">
        <div class="title">
            <img src="/images/matchmove.png" alt="Matchmove" class="logo">
        </div>
    </div>

    <div class="login-section">

        <h2 class="text-center mb-4">Login</h2>

        <% if (errors && errors.length > 0) { %>
            <div class="alert alert-danger text-start">
                <% errors.forEach(function(error) { %>
                    <p><%= error %></p>
                <% }); %>
            </div>
        <% } %>

        <% if (messages && messages.length > 0) { %>
            <div class="alert alert-success text-start">
                <% messages.forEach(function(message) { %>
                    <p><%= message %></p>
                <% }); %>
            </div>
        <% } %>

        <form action="/login" method="POST">
            <div class="mb-3">
                <input 
                    type="email" 
                    id="userEmail" 
                    name="userEmail" 
                    class="form-control" 
                    placeholder="Email"
                    required>
            </div>

            <div class="mb-3">
                <input 
                    type="password" 
                    id="userPassword" 
                    name="userPassword" 
                    class="form-control"
                    placeholder="Password"
                    required>
            </div>

            <button type="submit" class="login-btn">Login</button>
        </form>

    </div>

</body>
</html>