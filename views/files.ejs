<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <title>Upload History</title>

  <!-- Bootstrap -->
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css">
  <link rel="stylesheet" href="https://cdn.datatables.net/1.13.6/css/dataTables.bootstrap5.min.css">
</head>

<body>

<%- include('partial/navbar') %>
<%- include('partial/sidebar') %>

<div class="container mt-4">

  <h3 class="mb-2">📁 Upload History</h3>
  <p class="text-muted">All Excel files uploaded into the system</p>

  <div class="card p-3">
    <div class="table-responsive">
      <table id="filesTable" class="table table-bordered table-hover table-sm">
        <thead class="table-dark">
          <tr>
            <th>ID</th>
            <th>Filename</th>
            <th>Uploaded By</th>
            <th>Rows</th>
            <th>Uploaded At</th>
            <th>Actions</th>
          </tr>
        </thead>
        <tbody>
          <% files.forEach(file => { %>
            <tr>
              <td><%= file.id %></td>
              <td><%= file.filename %></td>
              <td><%= file.username %></td>
              <td><%= file.row_count %></td>
              <td><%= new Date(file.uploaded_at).toLocaleString() %></td>
              <td>
                <!-- Only keep View button -->
                <a href="/dashboard?fileId=<%= file.id %>" class="btn btn-sm btn-primary">
                  View
                </a>
              </td>
            </tr>
          <% }) %>
        </tbody>
      </table>
    </div>
  </div>
</div>

<script src="https://code.jquery.com/jquery-3.7.1.min.js"></script>
<script src="https://cdn.datatables.net/1.13.6/js/jquery.dataTables.min.js"></script>
<script src="https://cdn.datatables.net/1.13.6/js/dataTables.bootstrap5.min.js"></script>

<script>
  $(document).ready(function () {
    $('#filesTable').DataTable({
      pageLength: 10,
      ordering: true
    });
  });
</script>

</body>
</html>
